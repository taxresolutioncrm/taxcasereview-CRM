{
  "name": "tcr-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "check-polling": "node scripts/check-polling-intervals.cjs",
    "check-critical-workflows": "node scripts/check-critical-workflow-invariants.cjs",
    "check-formacorp-native": "node scripts/check-formacorp-native-invariants.cjs",
    "check-manual-sync": "node scripts/check-manual-sync.cjs",
    "manual:style": "node scripts/manual-professionalize.mjs",
    "storage:fix-display": "node scripts/fix-storage-usage-display.mjs",
    "email:state-sync": "node scripts/fix-email-state-sync.mjs",
    "email:count-sync": "node scripts/fix-email-bulk-counts.mjs",
    "sidebar:badge-rpc": "node scripts/fix-sidebar-badge-rpc.mjs",
    "dashboard:glow": "node scripts/restore-dashboard-card-glow.mjs",
    "forms:state-esign-prefill": "node scripts/fix-state-esign-prefill.mjs",
    "forms:irs-current": "node scripts/fix-irs-current-field-maps.mjs",
    "reports:accuracy": "node scripts/fix-reporting-accuracy.mjs",
    "accounting:oauth-state": "node scripts/fix-accounting-oauth-state.mjs",
    "admin:metrics-proxy": "node scripts/fix-crm-metrics-proxy.mjs",
    "admin:product-usage-labels": "node scripts/fix-admin-product-usage-labels.cjs",
    "cases:modal-scope": "node scripts/fix-cases-modal-reps.mjs",
    "ui:quick-create": "node scripts/fix-quick-create-routes.mjs",
    "ui:navigation-audit": "node scripts/audit-ui-navigation.mjs",
    "source:verify-current": "git diff --exit-code -- src scripts package.json vite.config.js 2>/dev/null || (echo 'ERROR: prebuild repair scripts changed tracked source. Commit the source fix instead of building mutated source.' && exit 1)",
    "prebuild": "npm run cloudcpa:readiness && npm run check-family-auth && npm run check-transcripts && npm run check-nashville-closeout && npm run check-polling && npm run check-critical-workflows && npm run check-client-case-quick-actions && npm run check-formacorp-native && npm run check-manual-sync && npm run check-dashboard-i18n && npm run manual:style && npm run storage:fix-display && npm run email:state-sync && npm run email:count-sync && npm run sidebar:badge-rpc && npm run dashboard:glow && npm run forms:state-esign-prefill && npm run forms:irs-current && npm run reports:accuracy && npm run accounting:oauth-state && npm run admin:metrics-proxy && npm run admin:product-usage-labels && npm run cases:modal-scope && npm run ui:quick-create && npm run ui:navigation-audit && npm run source:verify-current",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist --dotfiles",
    "check-dashboard-i18n": "node scripts/check-dashboard-localization.mjs",
    "cloudcpa:readiness": "node scripts/certify-cloudcpa-readiness.mjs",
    "check-family-auth": "node scripts/check-taxres-family-auth.mjs",
    "check-nashville-closeout": "node scripts/check-nashville-closeout.cjs",
    "check-client-case-quick-actions": "node scripts/check-client-case-quick-actions.cjs",
    "check-transcripts": "node scripts/check-taxres-transcript-contract.mjs"
  },
  "dependencies": {
    "@signalwire/js": "^1.5.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
