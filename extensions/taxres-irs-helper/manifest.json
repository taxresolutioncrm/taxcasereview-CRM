{
  "manifest_version": 3,
  "name": "TaxRes IRS Helper",
  "version": "1.0.0",
  "description": "Sends the IRS transcript PDFs you choose back to your TaxRes CRM. Never reads, stores or sends your IRS / ID.me sign-in.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://*.irs.gov/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.irs.gov/semail/*", "https://*.irs.gov/esrv/*"],
      "js": ["mailbox.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://taxrescrm.app/*", "https://*.taxrescrm.app/*"],
      "js": ["crm-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon48.png", "128": "icon128.png" }
}
